{
	"name": "cohesion-web",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node -e \"import('node:fs').then((fs) => fs.writeFileSync('build/.gitkeep', ''))\"",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"generate": "cargo run -q -p cohesion-core --example ts_client > src/lib/protocol/generated.ts && cargo run -q -p cohesion-core --example vocabulary > src/lib/protocol/vocabulary.json && prettier --write --log-level warn src/lib/protocol/generated.ts src/lib/protocol/vocabulary.json"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"@internationalized/date": "3.12.4",
		"@lezer/highlight": "1.2.5",
		"@lucide/svelte": "1.55.0",
		"bits-ui": "2.19.5",
		"dompurify": "3.4.17",
		"marked": "18.1.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	}
}
