[
  {
    "about": "A share widget, `share` at any boundary of its name, as in a site's `article-share` block.",
    "trigger": {
      "named": {
        "part": [
          "share",
          "sharedaddy"
        ]
      }
    },
    "action": "delete"
  },
  {
    "about": "A pitch rather than content: a call to action, promo, newsletter or membership sign-up, paywall or members-only (`restricted`) notice, sponsor block, list of related posts or block placed after the content. Parts match whole, so `subscription` or `post-content` stay.",
